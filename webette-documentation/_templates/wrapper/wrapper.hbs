<html lang="{{site.lang}}">
  <head>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta charset="utf-8" />
    <!-- Fonts -->
    <link rel="stylesheet" href="{{asset 'fonts/DraftingMono/DraftingMono.css'}}" />
    <link rel="stylesheet" href="{{asset 'css/init.css'}}" />
    <link rel="stylesheet" href="{{asset 'css/style.css'}}" />
    <title>
      {{#if entry}}{{displayName entry}} - {{site.title}}{{else}}{{site.title}}{{/if}}
    </title>
  </head>
  <body>
    <svg width="0" height="0" style="position: absolute;">
      <filter id="noise-texture">
        <feTurbulence
          type="fractalNoise"
          baseFrequency="0.85"
          numOctaves="2"
          seed="0"
          stitchTiles="stitch"
        />
        <feColorMatrix type="saturate" values="0" />
        <feComponentTransfer>
          <feFuncA type="discrete" tableValues="0 0.35" />
        </feComponentTransfer>
        <feBlend mode="multiply" in="SourceGraphic" />
      </filter>
    </svg>

    <div class="site-rail" aria-hidden="false">
      <div class="corner-slot">
        {{#unless (eq entry.route "/")}}
          <a class="corner-logo" href="/" aria-label="Home">
            <span class="corner-logo-icon" aria-hidden="true"></span>
          </a>
        {{/unless}}
      </div>

      <a class="side-wordmark" href="/" aria-label="Home">webette</a>
    </div>

    <div class="site-page">
      <header class="site-frame">
        <nav class="top-menu" aria-label="Site menu">
          {{#menu}}
            <input class="top-menu-radio" type="radio" name="top-menu" id="top-menu-none" checked />

            {{#each items}}
              {{#if (eq kind "collection")}}
                {{#unless (eq collection.entriesCount 1)}}
                  <input
                    class="top-menu-radio"
                    type="radio"
                    name="top-menu"
                    id="top-menu-{{collection.slug}}"
                  />
                {{/unless}}
              {{/if}}
            {{/each}}

            <div class="top-menu-tabs">
              {{#each items}}
                {{#if (eq kind "collection")}}
                  <div class="top-menu-tabwrap">
                    {{#if (eq collection.entriesCount 1)}}
                      {{#with (first children)}}
                        <a
                          class="top-menu-tab top-menu-tab--link {{#if ../isCurrent}}is-current{{/if}}"
                          href="{{route}}"
                          {{#if isActive}}aria-current="page"{{/if}}
                        >
                          {{displayName ../collection}}
                        </a>
                      {{/with}}
                    {{else}}
                      <label class="top-menu-tab top-menu-tab--open {{#if isCurrent}}is-current{{/if}}" for="top-menu-{{collection.slug}}">
                        {{displayName collection}}
                      </label>
                      <label class="top-menu-tab top-menu-tab--close" for="top-menu-none" data-close="{{collection.slug}}">
                        {{displayName collection}}
                      </label>
                    {{/if}}
                  </div>
                {{/if}}
              {{/each}}
            </div>

            <div class="top-menu-panels">
              {{#each items}}
                {{#if (eq kind "collection")}}
                  {{#unless (eq collection.entriesCount 1)}}
                    <div class="top-menu-panel" id="top-menu-panel-{{collection.slug}}">
                      <ul class="top-menu-tree">
                        {{#each children}}
                          {{#if (eq kind "entry")}}
                            <li class="top-menu-tree-item">
                              <span class="tree-line {{#if isActive}}is-active{{/if}} {{#if @last}}last-tree-line{{/if}}">&#8195;&#8195;&#8195;</span>
                              <a
                                class="top-menu-entry {{#if isActive}}is-active{{/if}}"
                                href="{{route}}"
                                {{#if isActive}}aria-current="page"{{/if}}
                              >
                                <span class="tree-ascii">&#9492;&#9472;&#9472;</span> {{#if title}}{{title}}{{else}}{{displayName entry}}{{/if}}
                              </a>
                              {{#if entry.isDraft}}
                                <span class="draft-pill">draft</span>
                              {{/if}}
                            </li>
                          {{/if}}
                        {{/each}}
                      </ul>
                    </div>
                  {{/unless}}
                {{/if}}
              {{/each}}
            </div>

            <style>
              {{#each items}}
                {{#if (eq kind "collection")}}
                  {{#unless (eq collection.entriesCount 1)}}
                    #top-menu-{{collection.slug}}:checked ~ .top-menu-tabs label[data-close="{{collection.slug}}"] {
                      background: var(--accent);
                      color: color-mix(in lch shorter hue, var(--bg-box) 100%, white 50%);
                    }

                    #top-menu-{{collection.slug}}:checked ~ .top-menu-tabs label[data-close="{{collection.slug}}"] {
                      display: inline-block;
                    }

                    #top-menu-{{collection.slug}}:checked ~ .top-menu-tabs label[for="top-menu-{{collection.slug}}"] {
                      display: none;
                    }

                    #top-menu-{{collection.slug}}:checked ~ .top-menu-panels #top-menu-panel-{{collection.slug}} {
                      max-height: 70vh;
                      margin: var(--gutter) 0 0;
                      pointer-events: auto;
                    }
                  {{/unless}}
                {{/if}}
              {{/each}}
            </style>
          {{/menu}}
        </nav>
      </header>

      <div class="container">
        {{{renderLayout layoutName}}}
      </div>
    </div>

    <div class="noise"></div>

  </body>
</html>

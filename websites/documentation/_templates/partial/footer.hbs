<footer class="site-footer">
  <div class="site-footer-left">
    <p>Site generated by webette</p>
  </div>

  <div class="site-footer-right">
    {{#if entry.createdAt}}
      <p>Page created on: <time datetime="{{entry.createdAt}}">{{formatDate entry.createdAt}}</time></p>
      {{#if entry.updatedAt}}
        <p>Page last modified on: <time datetime="{{entry.updatedAt}}">{{formatDate entry.updatedAt}}</time></p>
      {{/if}}
    {{else if collection.createdAt}}
      <p>Page created on: <time datetime="{{collection.createdAt}}">{{formatDate collection.createdAt}}</time></p>
      {{#if collection.updatedAt}}
        <p>Page last modified on: <time datetime="{{collection.updatedAt}}">{{formatDate collection.updatedAt}}</time></p>
      {{/if}}
    {{else}}
      {{#if site.createdAt}}
        <p>Page created on: <time datetime="{{site.createdAt}}">{{formatDate site.createdAt}}</time></p>
      {{/if}}
      {{#if site.updatedAt}}
        <p>Page last modified on: <time datetime="{{site.updatedAt}}">{{formatDate site.updatedAt}}</time></p>
      {{/if}}
    {{/if}}
  </div>
</footer>

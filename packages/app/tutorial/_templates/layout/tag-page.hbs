<main>
  <article>
    <header class="index-header">
      <h1>{{#if collection}}{{displayName collection}} — {{/if}}#{{tag}}</h1>
    </header>
    <section class="navigation">
      <ul class="navigation-list">
        {{#each entries}}
          <li class="navigation-item navigation-item--entry">
            <a href="{{route}}" class="navigation-link navigation-link--entry">{{displayName this}}</a>
          </li>
        {{/each}}
      </ul>
    </section>
  </article>
</main>

{{> footer}}

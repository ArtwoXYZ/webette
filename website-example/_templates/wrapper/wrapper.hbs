<html lang="{{site.lang}}">
  <head>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta charset="utf-8" />
    <!-- Fonts -->
    <link rel="stylesheet" href="{{asset 'fonts/DraftingMono/DraftingMono.css'}}" />
    <link rel="stylesheet" href="{{asset 'css/init.css'}}" />
    <link rel="stylesheet" href="{{asset 'css/style.css'}}" />
    <title>
      {{#if entry}}{{displayName entry}} - {{site.title}}{{else}}{{site.title}}{{/if}}
    </title>
    {{{iconsHead}}}
  </head>
  <body>
    <svg width="0" height="0" style="position: absolute;">
      <filter id="noise-texture">
        <feTurbulence
          type="fractalNoise"
          baseFrequency="0.85"
          numOctaves="2"
          seed="0"
          stitchTiles="stitch"
        />
        <feColorMatrix type="saturate" values="0" />
        <feComponentTransfer>
          <feFuncA type="discrete" tableValues="0 0.35" />
        </feComponentTransfer>
        <feBlend mode="multiply" in="SourceGraphic" />
      </filter>
    </svg>

    <div class="site-rail" aria-hidden="false">
      <div class="corner-slot">
        {{#unless (eq entry.route "/")}}
          <a class="corner-logo" href="/" aria-label="Home">
            <span class="corner-logo-icon" aria-hidden="true"></span>
          </a>
        {{/unless}}
      </div>

      <a class="side-wordmark" href="/" aria-label="Home">webette</a>
    </div>

    <div class="site-page">
      <header class="site-frame">
        <nav class="top-menu" aria-label="Site menu">
          {{#menu}}
            <input class="top-menu-radio" type="radio" name="top-menu" id="top-menu-none" checked />

            {{#each collections}}
              {{#unless hasSingleEntry}}
                <input
                  class="top-menu-radio"
                  type="radio"
                  name="top-menu"
                  id="top-menu-{{slug}}"
                />
              {{/unless}}
            {{/each}}

            <div class="top-menu-tabs">
              {{#each collections}}
                <div class="top-menu-tabwrap">
                  {{#if hasSingleEntry}}
                    <a
                      class="top-menu-tab top-menu-tab--link {{#if isCurrent}}is-current{{/if}}"
                      href="{{singleEntry.route}}"
                      {{#if singleEntry.isActive}}aria-current="page"{{/if}}
                    >
                      {{displayName this}}
                    </a>
                  {{else}}
                    <label class="top-menu-tab top-menu-tab--open {{#if isCurrent}}is-current{{/if}}" for="top-menu-{{slug}}">
                      {{displayName this}}
                    </label>
                    <label class="top-menu-tab top-menu-tab--close" for="top-menu-none" data-close="{{slug}}">
                      {{displayName this}}
                    </label>
                  {{/if}}
                </div>
              {{/each}}
            </div>

            <div class="top-menu-panels">
              {{#each collections}}
                {{#unless hasSingleEntry}}
                  <div class="top-menu-panel" id="top-menu-panel-{{slug}}">
                    <ul class="top-menu-tree">
                      {{#each entries}}
                        <li class="top-menu-tree-item">
                          <span class="tree-line {{#if isActive}}is-active{{/if}} {{#if @last}}last-tree-line{{/if}}">&#8195;&#8195;&#8195;</span>
                          <a
                            class="top-menu-entry {{#if isActive}}is-active{{/if}}"
                            href="{{route}}"
                            {{#if isActive}}aria-current="page"{{/if}}
                          >
                            <span class="tree-ascii">&#9492;&#9472;&#9472;</span> {{displayName this}}
                          </a>
                          {{#if isDraft}}
                            <span class="draft-pill">draft</span>
                          {{/if}}
                        </li>
                      {{/each}}
                    </ul>
                  </div>
                {{/unless}}
              {{/each}}
            </div>

            <style>
              {{#each collections}}
                {{#unless hasSingleEntry}}
                  #top-menu-{{slug}}:checked ~ .top-menu-tabs label[data-close="{{slug}}"] {
                    background: var(--accent);
                    color: color-mix(in lch shorter hue, var(--bg-box) 100%, white 50%);
                  }

                  #top-menu-{{slug}}:checked ~ .top-menu-tabs label[data-close="{{slug}}"] {
                    display: inline-block;
                  }

                  #top-menu-{{slug}}:checked ~ .top-menu-tabs label[for="top-menu-{{slug}}"] {
                    display: none;
                  }

                  #top-menu-{{slug}}:checked ~ .top-menu-panels #top-menu-panel-{{slug}} {
                    max-height: 70vh;
                    margin: var(--gutter) 0 0;
                    pointer-events: auto;
                  }
                {{/unless}}
              {{/each}}
            </style>
          {{/menu}}
        </nav>
      </header>

      <div class="container">
        {{{renderLayout layoutName}}}
      </div>
    </div>

    <div class="noise"></div>

  </body>
</html>

<html lang="{{site.lang}}">
  <head>
    <meta charset="utf-8" />
    <link rel="stylesheet" href="{{asset 'css/init.css'}}" />
    <link rel="stylesheet" href="{{asset 'css/style.css'}}" />
    <title>
      {{#if entry}}{{displayName entry}} - {{site.title}}{{else}}{{site.title}}{{/if}}
    </title>
  </head>
  <body>
    <svg width="0" height="0" style="position: absolute;">
      <filter id="noise-texture">
          <feTurbulence 
              type="fractalNoise" 
              baseFrequency="0.85" 
              numOctaves="2" 
              seed="0"
              stitchTiles="stitch"/>
          <feColorMatrix type="saturate" values="0"/>
          <feComponentTransfer>
              <feFuncA type="discrete" tableValues="0 0.35"/>
          </feComponentTransfer>
          <feBlend mode="multiply" in="SourceGraphic"/>
      </filter>
  </svg>
    <div class="container">
      {{{renderLayout layoutName}}}
    </div>

    <div class="noise"></div>

    {{{liveReloadScript}}}
  </body>
</html>

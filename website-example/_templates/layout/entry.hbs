<main>
  <article>
    {{#if entry.isDraft}}
      <p class="draft-badge">Draft (unpublished)</p>
    {{/if}}

    {{#each blocks}}
      {{#if (eq type "markdown")}}
        <section class="markdown prose">
          {{{safe content.html}}}
        </section>
      {{else if (eq type "text")}}
        <section class="text">
          <pre>{{content.raw}}</pre>
        </section>
      {{else if (eq type "image")}}
        {{#unless content.meta.renderedInline}}
          <section class="image">
            {{image this figure=true caption=name class="my-class"}}
          </section>
        {{/unless}}
      {{else if (eq type "audio")}}
        <section class="audio">
          <audio controls src="{{route}}"></audio>
        </section>
      {{else if (eq type "video")}}
        <section class="video">
          <video controls src="{{route}}"></video>
        </section>
      {{else if (eq type "navigation")}}
        {{#if content.data.items}}
          <section class="navigation">
            {{#if content.data.name}}
              <h2 class="navigation-title">{{content.data.name}}</h2>
            {{/if}}

            {{> navigation-items items=content.data.items}}
          </section>
        {{/if}}
      {{/if}}
    {{/each}}

    {{#if entry.pluginNote}}
      <p>
        Plugin: <em>{{entry.pluginNote}}</em>
      </p>
    {{/if}}

    {{#if prevEntry}}
      <nav class="prev-next">
        <a class="prev-next-link prev" href="{{prevEntry.route}}">◀ {{displayName prevEntry}}</a>
        {{#if nextEntry}}
          <a class="prev-next-link next" href="{{nextEntry.route}}">{{displayName nextEntry}} ▶</a>
        {{/if}}
      </nav>
    {{else}}
      {{#if nextEntry}}
        <nav class="prev-next">
          <a class="prev-next-link next" href="{{nextEntry.route}}">{{displayName nextEntry}} ▶</a>
        </nav>
      {{/if}}
    {{/if}}
  </article>
</main>

{{> footer}}

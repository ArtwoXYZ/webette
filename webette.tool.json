{
  "logging": {
    "level": "info",
    "locale": "fr",
    "dirName": ".webette"
  },
  "serve": {
    "port": 4173,
    "liveReloadIntervalMs": 1000,
    "watcherDebounceMs": 150
  },
  "build": {
    "outputDirName": "_public",
    "overwrite": "replace-files",
    "readContent": true,
    "exportModel": {
      "enabled": true,
      "dir": ".webette/_model",
      "only": false
    }
  },
  "templates": {
    "root": "templates",
    "default": "wrapper.html"
  }
}

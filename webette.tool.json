{
  "logging": {
    "level": "info",
    "locale": "fr",
    "dirName": ".webette"
  },
  "serve": {
    "port": 4173,
    "liveReloadIntervalMs": 1000,
    "watcherDebounceMs": 150
  },
  "build": {
    "ignoreNames": ["_public", ".webette"],
    "outputDirName": "_public",
    "overwrite": "replace-files"
  },
  "templates": {
    "root": "templates",
    "default": "wrapper.html"
  }
}

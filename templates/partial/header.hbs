<header>
  <h1>{{site.title}}</h1>
  <nav>
    {{#if collection.route}}
      <a href="{{collection.route}}">← Back to collection</a>
    {{else}}
      <a href="/">← Back to index</a>
    {{/if}}
  </nav>
  <h3>Collection: {{displayName collection}}</h3>
  {{#menu}}
    <nav class="site-menu" aria-label="Site menu">
      <ul>
        {{#each items}}
          {{#if (eq kind "collection")}}
            <li>
              {{#if (eq collection.entriesCount 1)}}
                {{#with (first children)}}
                  <a href="{{route}}" class="{{#if ../isCurrent}}is-current{{/if}}">
                    {{displayName ../collection}}
                  </a>
                {{/with}}
              {{else}}
                <a href="{{route}}" class="{{#if isCurrent}}is-current{{/if}}">
                  {{displayName collection}}
                </a>
              {{/if}}
            </li>
          {{/if}}
        {{/each}}
      </ul>
    </nav>
  {{/menu}}
</header>

<header>
  <h1>{{site.title}}</h1>
  <nav>
    {{#if collection.route}}
      <a href="{{collection.route}}">← Back to collection</a>
    {{else}}
      <a href="/">← Back to index</a>
    {{/if}}
  </nav>
  <h3>Collection: {{displayName collection}}</h3>
  {{#menu}}
    <nav class="site-menu" aria-label="Site menu">
      <ul>
        {{#each collections}}
          <li>
            <a
              href="{{#if hasSingleEntry}}{{singleEntry.route}}{{else}}{{route}}{{/if}}"
              class="{{#if isCurrent}}is-current{{/if}}"
            >
              {{displayName this}}
            </a>
          </li>
        {{/each}}
      </ul>
    </nav>
  {{/menu}}
</header>

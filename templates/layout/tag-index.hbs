<main>
  <article>
    <header class="index-header">
      <h1>{{#if collection}}Tags — {{displayName collection}}{{else}}All tags{{/if}}</h1>
    </header>
    <section class="tag-list">
      {{#each tags}}
        <a class="tag" href="{{tagRoute this ../collection}}">{{this}}</a>
      {{/each}}
    </section>
  </article>
</main>

{{> header}}

<main>
  <article>
    <h2>{{displayName entry}}</h2>

    {{#if entry.isDraft}}
      <p class="draft-badge">Brouillon (non publié)</p>
    {{/if}}

    {{#each blocks}}
      {{#if (eq type "markdown")}}
        {{{safe content.html}}}
      {{else if (eq type "text")}}
        <pre>{{content.raw}}</pre>
      {{else if (eq type "image")}}
        {{#unless content.meta.renderedInline}}
          <figure>
            <img src="{{route}}" alt="{{name}}" />
            <figcaption>{{name}}</figcaption>
          </figure>
        {{/unless}}
      {{else if (eq type "audio")}}
        <audio controls src="{{route}}"></audio>
      {{else if (eq type "video")}}
        <video controls src="{{route}}"></video>
      {{/if}}
    {{/each}}

    {{#if entry.pluginNote}}
      <p>Plugin: <em>{{entry.pluginNote}}</em></p>
    {{/if}}

    {{#if prevEntry}}
      <nav class="prev-next">
        <a class="prev-next-link prev" href="{{prevEntry.route}}">← {{displayName prevEntry}}</a>
        {{#if nextEntry}}
          <a class="prev-next-link next" href="{{nextEntry.route}}">{{displayName nextEntry}} →</a>
        {{/if}}
      </nav>
    {{else}}
      {{#if nextEntry}}
        <nav class="prev-next">
          <a class="prev-next-link next" href="{{nextEntry.route}}">{{displayName nextEntry}} →</a>
        </nav>
      {{/if}}
    {{/if}}
  </article>
</main>

{{> footer}}


<h1>{{site.title}}</h1>

{{#if blocks}}
  <section class="index-content">
    {{#each blocks}}
      {{#if (eq type "markdown")}}
        {{{safe content.html}}}
      {{else if (eq type "text")}}
        <pre>{{content.raw}}</pre>
      {{else if (eq type "image")}}
        {{#unless content.meta.renderedInline}}
          <figure>
            <img src="{{route}}" alt="{{name}}" />
            <figcaption>{{name}}</figcaption>
          </figure>
        {{/unless}}
      {{else if (eq type "audio")}}
        <audio controls src="{{route}}"></audio>
      {{else if (eq type "video")}}
        <video controls src="{{route}}"></video>
      {{/if}}
    {{/each}}
  </section>
{{/if}}

{{#menu}}
  {{#if current.collection}}
    <h2>Collection: {{displayName current.collection}}</h2>
    <p>{{current.collection.entries.length}} entries</p>
    <ul>
      <li><a href="/">← Back to root</a></li>
      {{#each current.collection.entries}}
        <li>
          <a href="{{route}}">{{displayName this}}</a>
          ({{blocks.length}}
          blocks)
        </li>
      {{/each}}
    </ul>
  {{else}}
    <h2>Collections</h2>
    <ul>
      {{#each collections}}
        <li>
          <a href="{{route}}">{{displayName this}}</a>
          ({{entries.length}}
          entries)
        </li>
      {{/each}}
    </ul>
  {{/if}}
{{/menu}}

<p>Last build: {{formatDate buildTime dateStyle="long"}}</p>
<p>Last update: {{formatDate site.updatedAt dateStyle="long"}}</p>

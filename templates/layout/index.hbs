<h1>{{site.title}}</h1>

{{#menu}}
  {{#if current.collection}}
    <h2>Collection: {{displayName current.collection}}</h2>
    <p>{{current.collection.entries.length}} entries</p>
    <ul>
      <li><a href="/">← Back to root</a></li>
      {{#each current.collection.entries}}
        <li>
          <a href="{{route}}">{{displayName this}}</a>
          ({{blocks.length}}
          blocks)
        </li>
      {{/each}}
    </ul>
  {{else}}
    <h2>Collections</h2>
    <ul>
      {{#each collections}}
        <li>
          <a href="{{route}}">{{displayName this}}</a>
          ({{entries.length}}
          entries)
        </li>
      {{/each}}
    </ul>
  {{/if}}
{{/menu}}

<p>Last build: {{formatDate buildTime dateStyle="long"}}</p>
<p>Last update: {{formatDate site.updatedAt dateStyle="long"}}</p>

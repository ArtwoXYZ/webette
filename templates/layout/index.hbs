<h1>{{site.title}}</h1>

{{#if collection}}
  <h2>Collection: {{displayName collection}}</h2>
  <p>{{entries.length}} entries</p>
  <ul>
    <li><a href="/">← Back to root</a></li>
    {{#each entries}}
      <li>
        <a href="{{route}}">{{displayName this}}</a>
        ({{blocks.length}}
        blocks)
      </li>
    {{/each}}
  </ul>
{{else}}
  <h2>Collections</h2>
  <ul>
    {{#each collections}}
      <li>
        <a href="{{route}}">{{displayName this}}</a>
        ({{entries.length}}
        entries)
      </li>
    {{/each}}
  </ul>
{{/if}}

<p>Last build: {{formatDate buildTime dateStyle="long"}}</p>
<p>Last update: {{formatDate site.updatedAt dateStyle="long"}}</p>

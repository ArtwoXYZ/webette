<h1>{{site.title}}</h1>

{{#if blocks}}
  <section class="index-content">
    {{#each blocks}}
      {{#if (eq type "markdown")}}
        {{{safe content.html}}}
      {{else if (eq type "text")}}
        <pre>{{content.raw}}</pre>
      {{else if (eq type "image")}}
        {{#unless content.meta.renderedInline}}
          <figure>
            <img src="{{route}}" alt="{{name}}" />
            <figcaption>{{name}}</figcaption>
          </figure>
        {{/unless}}
      {{else if (eq type "audio")}}
        <audio controls src="{{route}}"></audio>
      {{else if (eq type "video")}}
        <video controls src="{{route}}"></video>
      {{/if}}
    {{/each}}
  </section>
{{/if}}

{{#menu}}
  {{#if collection}}
    <h2>Collection: {{displayName collection}}</h2>
    <p>{{collection.entries.length}} entries</p>
    <ul>
      <li><a href="/">← Back to root</a></li>
      {{#each items}}
        {{#if (eq kind "collection")}}
          {{#if isCurrent}}
            {{#each children}}
              {{#if (eq kind "entry")}}
                <li>
                  <a href="{{route}}">{{displayName entry}}</a>
                </li>
              {{/if}}
            {{/each}}
          {{/if}}
        {{/if}}
      {{/each}}
    </ul>
  {{else}}
    <h2>Collections</h2>
    <ul>
      {{#each items}}
        {{#if (eq kind "collection")}}
          <li>
            <a href="{{route}}">{{displayName collection}}</a>
            ({{collection.entriesCount}}
            entries)
          </li>
        {{/if}}
      {{/each}}
    </ul>
  {{/if}}
{{/menu}}

<p>Last build: {{formatDate buildTime dateStyle="long"}}</p>
<p>Last update: {{formatDate site.updatedAt dateStyle="long"}}</p>
